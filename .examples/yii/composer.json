{
    "name": "yiisoft/app",
    "type": "project",
    "description": "Yii3 web application template",
    "keywords": [
        "yii3",
        "app"
    ],
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "support": {
        "issues": "https://github.com/yiisoft/app/issues?state=open",
        "source": "https://github.com/yiisoft/app",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "phpstan": [
            "@php vendor/bin/codecept build",
            "@php vendor/bin/phpstan analyze"
        ],
        "lint-rector": "@php vendor/bin/rector process --dry-run",
        "lint-php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "lint": [
            "@phpstan",
            "@lint-php-cs",
            "@lint-rector",
            "@lint-composer"
        ],
        "lint-composer": "@composer validate --strict --no-check-publish",
        "rector": "@php vendor/bin/rector process",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fix"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "codecept run"
        ],
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); }\""
        ]
    },
    "require": {
        "php": "^8.2",
        "ext-filter": "*",
        "cmsig/seal": "^0.12",
        "cmsig/seal-yii-module": "^0.12",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.3",
        "symfony/process": "^7.4.3",
        "vlucas/phpdotenv": "^5.6.3",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/data-response": "^2.1.2",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/html": "^3.12",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/log-target-file": "^3.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-provider": "^1.2",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.1",
        "yiisoft/view": "^12.2.2",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.3.1"
    },
    "require-dev": {
        "cmsig/seal-algolia-adapter": "^0.12",
        "cmsig/seal-elasticsearch-adapter": "^0.12",
        "cmsig/seal-loupe-adapter": "^0.12",
        "cmsig/seal-meilisearch-adapter": "^0.12",
        "cmsig/seal-memory-adapter": "^0.12",
        "cmsig/seal-multi-adapter": "^0.12",
        "cmsig/seal-opensearch-adapter": "^0.12",
        "cmsig/seal-read-write-adapter": "^0.12",
        "cmsig/seal-redisearch-adapter": "^0.12",
        "cmsig/seal-solr-adapter": "^0.12",
        "cmsig/seal-typesense-adapter": "^0.12",
        "codeception/c3": "^2.9",
        "codeception/codeception": "^5.3.3",
        "codeception/module-asserts": "^3.3.0",
        "codeception/module-cli": "^2.0.1",
        "codeception/module-phpbrowser": "^3.0.2",
        "php-cs-fixer/shim": "^3.92.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-phpunit": "^2.0.11",
        "rector/rector": "^2.3",
        "phpunit/phpunit": "^11.5.46"
    },
    "conflict": {
        "react/promise": "<2.2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./../../packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "./../../integrations/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "codeception/c3": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "yiisoft/config": true
        }
    }
}
